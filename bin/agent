#!/usr/bin/env bash
# The daily run's entry point to the app: the same commands as `pnpm agent:*`,
# without pnpm's wrapper, so exit codes (0 ok, 1 errors, 2 stored with warnings)
# and output reach the caller unchanged.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
exec "$ROOT/packages/core/node_modules/.bin/tsx" --env-file="$ROOT/.env" "$ROOT/packages/core/src/cli/agent.ts" "$@"
