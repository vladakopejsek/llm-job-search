# Postgres connection string.
DATABASE_URL=postgres://postgres:password@localhost:5432/job_search
# A role that can only read, for Ask's tools (GRANT pg_read_all_data). Without it, Ask answers with an error.
DATABASE_URL_READONLY=postgres://job_search_ro:password@localhost:5432/job_search

# Anthropic API key, created inside a workspace (Console → Workspaces → API keys). The model steps use it (daily-run, fresh,
# Draft packs, eval); without it they run as Claude Code skills on the subscription.
ANTHROPIC_API_KEY=

# Optional: send a trace of every API call to an OTLP backend, such as Langfuse.
# The traces hold the full prompts, including the CV and the Answer bank. Leave unset to keep everything local.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of public:secret>,x-langfuse-ingestion-version=4
